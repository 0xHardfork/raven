{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RavenScraperOutput",
  "description": "Standard output schema for Raven threat collection scripts",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["cve_id", "title", "categories", "source"],
    "properties": {
      "cve_id": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$",
        "description": "Normalized uppercase CVE identifier (e.g. CVE-2024-4577)"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Short summary or vulnerability title"
      },
      "description": {
        "type": "string",
        "description": "Detailed vulnerability description"
      },
      "severity": {
        "type": "string",
        "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"],
        "default": "UNKNOWN"
      },
      "cvss_score": {
        "type": ["number", "null"],
        "minimum": 0.0,
        "maximum": 10.0,
        "description": "CVSS v3.x score if available"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Self-declared language/ecosystem tags (e.g. ['java', 'spring'], ['golang'], ['php'])"
      },
      "is_exploited": {
        "type": "boolean",
        "default": false,
        "description": "Whether known to be exploited in the wild (e.g. CISA KEV)"
      },
      "pocs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "author": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "default": []
      },
      "source": {
        "type": "string",
        "description": "Identifier of the scraper source (e.g. github_pocs, cisa_kev, exploit_db, nvd)"
      },
      "published_at": {
        "type": ["string", "null"],
        "format": "date-time",
        "description": "Publication timestamp in ISO 8601 format"
      },
      "raw_data": {
        "type": "object",
        "description": "Optional upstream metadata dictionary"
      }
    }
  }
}
